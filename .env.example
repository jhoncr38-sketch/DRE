# Banco de dados Supabase
# Copie este arquivo para ".env" e preencha. O ".env" não vai para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA: "anon" (começa com eyJ...) ou "publishable" (sb_publishable_...).
# NUNCA use a "service_role" / "secret": ela passa por cima da segurança do banco.
SUPABASE_ANON_KEY=
